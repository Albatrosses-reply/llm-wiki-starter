{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "rq", "design", "data", "method", "findings", "mechanism", "limitations", "future",
               "contribution", "caveats", "relations", "concepts", "quotes", "tags", "read"],
  "properties": {
    "summary": {"type": "string", "description": "index용 한국어 한 줄 요약(120자 이내)"},
    "rq": {"type": "array", "items": {"type": "string"}, "description": "연구 질문 1~3개, 끝에 (PDF p.N) 또는 (초록)"},
    "design": {"type": "string"},
    "data": {"type": "string"},
    "method": {"type": "string", "description": "식별 전략·분석 방법"},
    "findings": {"type": "array", "items": {"type": "string"}, "description": "핵심 결과 3~5개, 근거 표시"},
    "mechanism": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}, "description": "저자가 밝힌 한계"},
    "future": {"type": "array", "items": {"type": "string"}, "description": "저자가 제안한 미래 연구"},
    "contribution": {"type": "string", "description": "사람 섹션 초안: 문헌에 더한 것 2~3문장, 저자 주장과 평가 구분, 근거 표시"},
    "caveats": {"type": "array", "items": {"type": "string"}, "description": "사람 섹션 초안: 독자가 조심할 점 2~3개"},
    "relations": {
      "type": "array",
      "description": "내 연구와의 관계. 대상은 주어진 내 원고(project) 또는 내 연구 주제(topic)만. 직접 겹칠 때만, 최대 2개. 없으면 빈 배열",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "why"],
        "properties": {"target": {"type": "string", "description": "project 슬러그(p-...) 또는 topic-1, topic-2, topic-3"},
                       "why": {"type": "string"}}
      }
    },
    "concepts": {
      "type": "array", "description": "이 논문의 핵심 개념·방법·데이터 1~3개. 이미 있는 개념이면 그 slug를 그대로",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["slug", "name", "kind", "definition"],
        "properties": {"slug": {"type": "string", "description": "영문 소문자-하이픈"},
                       "name": {"type": "string"},
                       "kind": {"type": "string", "enum": ["theory", "method", "measure", "dataset", "phenomenon", "institution"]},
                       "definition": {"type": "string", "description": "한국어 한두 문장"}}
      }
    },
    "quotes": {
      "type": "array", "description": "PDF 본문에서 그대로 옮긴 15단어 이하 인용 0~2개",
      "items": {"type": "object", "additionalProperties": false, "required": ["text", "page"],
                "properties": {"text": {"type": "string"}, "page": {"type": "integer"}}}
    },
    "tags": {"type": "array", "items": {"type": "string"}, "description": "영문 소문자 태그 3~6개"},
    "read": {"type": "string", "description": "실제 근거로 쓴 범위. 예: PDF p.1-4, 22-23"}
  }
}
